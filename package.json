{
  "name": "silicon-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open source React components and blocks with calm motion, by Team of Silicons. Install with the shadcn CLI or copy the code.",
  "license": "MIT",
  "author": "Team of Silicons",
  "homepage": "https://ui.teamofsilicons.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamofsilicons/silicon-ui.git"
  },
  "bugs": {
    "url": "https://github.com/teamofsilicons/silicon-ui/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:registry": "node scripts/build-registry.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:registry && npm run check:tokens",
    "site:extract": "node site/scripts/extract.mjs",
    "site:dev": "npm run site:extract && next dev site",
    "site:build": "npm run build:registry && npm run site:extract && next build site && node site/scripts/postbuild.mjs",
    "build:package": "node scripts/build-package.mjs",
    "build:stories": "node scripts/build-stories.mjs",
    "storybook": "npm run build:stories && storybook dev -p 6006",
    "build-storybook": "npm run build:stories && storybook build -o dist/storybook",
    "check:tokens": "node packaging/check.mjs"
  },
  "devDependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@storybook/nextjs-vite": "^10.6.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "siliconUi": {
    "css": [
      "registry/**/*.module.css"
    ],
    "ignore": [],
    "baseline": "silicon-ui-baseline.json"
  }
}
