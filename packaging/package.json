{
  "name": "@teamofsilicons/silicon-ui",
  "version": "0.3.0",
  "description": "React components with calm motion, on the Silicon design tokens. By Team of Silicons.",
  "license": "MIT",
  "author": "Team of Silicons",
  "homepage": "https://ui.teamofsilicons.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamofsilicons/silicon-ui.git"
  },
  "bugs": {
    "url": "https://github.com/teamofsilicons/silicon-ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui",
    "motion",
    "radix"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "silicon-ui-check": "./check.mjs"
  },
  "exports": {
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./styles.css"
    },
    "./provider": {
      "types": "./lib/silicon-provider.d.ts",
      "default": "./lib/silicon-provider.js"
    },
    "./motion-tokens": {
      "types": "./lib/motion-tokens.d.ts",
      "default": "./lib/motion-tokens.js"
    },
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    },
    "./eslint": "./eslint.js",
    "./components.json": "./components.json",
    "./package.json": "./package.json",
    "./*": {
      "types": "./components/*/*.d.ts",
      "default": "./components/*/*.js"
    }
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0"
  }
}
